<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:transitionGroup="true"
    tools:context=".post.PostMainFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutSwapPost"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLayoutSwapPost"
            style="@style/Theme.Reading_cycle.ToolbarTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:elevation="0dp"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/Theme.Reading_cycle.ToolbarTheme"
            app:layout_constraintEnd_toEndOf="@id/dividerSwapPost"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/baseline_arrow_back_ios_28">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconSwapPostTitle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:src="@drawable/baseline_sync_40_blue" />

                <TextView
                    android:id="@+id/toolbarTitleSwapPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:text="교환 도서"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#3B4AD3"
                    android:textSize="16dp" />
            </LinearLayout>


        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

        <View
            android:id="@+id/dividerSwapPost"
            android:layout_width="wrap_content"
            android:layout_height="1.5dp"
            android:background="#B2C8AA"
            android:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayoutSwapPost" />

    <ScrollView
        android:id="@+id/scrollViewSwapPost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:background="@color/background"
        android:fillViewport="true"
        android:nestedScrollingEnabled="true"
        android:transitionGroup="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutSwapPost"
        tools:context=".post.PostMainFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/frameSwapPost"
                android:layout_width="120dp"
                android:layout_height="173dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="17dp"
                android:layout_marginEnd="22dp"
                android:background="#9A9393"
                android:elevation="3dp"
                app:layout_constraintEnd_toStartOf="@+id/btnSwapPostType"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@drawable/border_add_post_gray">

                <ImageView
                    android:scaleType="centerInside"
                    android:id="@+id/imgSwapPostPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="0.8dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginBottom="0.8dp"
                    android:background="@color/white"
                    app:srcCompat="@drawable/baseline_image_24" />

            </FrameLayout>

            <TextView
                android:id="@+id/textSwapPostTitle"
                android:layout_width="215dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:fontFamily="@font/soyo_maple_bold"
                android:maxLines="1"
                android:text="책 제목"
                android:textColor="#000000"
                android:textSize="13dp"
                app:layout_constraintStart_toEndOf="@+id/frameSwapPost"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textSwapPost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/soyo_maple_bold"
                android:text="작가 "
                android:textColor="#017121"
                android:textSize="12dp"
                app:layout_constraintStart_toEndOf="@+id/frameSwapPost"
                app:layout_constraintTop_toBottomOf="@+id/textSwapPostTitle" />

            <TextView
                android:id="@+id/textSwapPost5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/soyo_maple_bold"
                android:text="도서 종류"
                android:textColor="#402200"
                android:textSize="8dp"
                app:layout_constraintBottom_toTopOf="@+id/btnSwapPostType"
                app:layout_constraintEnd_toEndOf="@+id/btnSwapPostType"
                app:layout_constraintStart_toStartOf="@+id/btnSwapPostType" />

            <TextView
                android:id="@+id/textSwapPost6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/soyo_maple_bold"
                android:text="필요 도서 종류"
                android:textColor="#000D4C"
                android:textSize="8dp"
                app:layout_constraintBottom_toTopOf="@+id/btnSwapPostType2"
                app:layout_constraintEnd_toEndOf="@+id/btnSwapPostType2"
                app:layout_constraintStart_toStartOf="@+id/btnSwapPostType2" />

            <TextView
                android:id="@+id/textSwapPostAuthor"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/soyo_maple_regular"
                android:maxLines="1"
                android:text="작가 이름"
                android:textColor="#000000"
                android:textSize="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/textSwapPost"
                app:layout_constraintStart_toEndOf="@+id/textSwapPost"
                app:layout_constraintTop_toTopOf="@+id/textSwapPost" />

            <Button
                android:id="@+id/btnSwapPostType"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                android:layout_weight="1"
                android:background="@drawable/border_add_post_orange"
                android:clickable="false"
                android:elevation="4dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:maxLines="1"
                android:padding="1dp"
                android:text="도서 종류"
                android:textColor="#633807"
                android:textSize="12dp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/frameSwapPost"
                app:layout_constraintTop_toBottomOf="@+id/textSwapPostAuthor" />

            <Button
                android:id="@+id/btnSwapPostType2"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/border_add_post_blue"
                android:clickable="false"
                android:elevation="4dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:maxLines="1"
                android:padding="1dp"
                android:text="가격"
                android:textColor="#232F9F"
                android:textSize="12dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/btnSwapPostType"
                app:layout_constraintStart_toEndOf="@+id/imgSwapPostType4"
                app:layout_constraintTop_toTopOf="@+id/btnSwapPostType" />

            <ImageView
                android:id="@+id/imgSwapPostType4"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:elevation="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/btnSwapPostType"
                app:layout_constraintStart_toEndOf="@+id/btnSwapPostType"
                app:layout_constraintTop_toTopOf="@+id/btnSwapPostType"
                app:srcCompat="@drawable/baseline_sync_40_blue" />

            <View
                android:id="@+id/borderSwapPost"
                android:layout_width="215dp"
                android:layout_height="60dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/border_s_post"
                app:layout_constraintStart_toEndOf="@+id/frameSwapPost"
                app:layout_constraintTop_toBottomOf="@+id/btnSwapPostType" />

            <ImageView
                android:id="@+id/imgSwapPostUser"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                app:layout_constraintStart_toStartOf="@+id/borderSwapPost"
                app:layout_constraintTop_toTopOf="@+id/borderSwapPost"
                app:srcCompat="@drawable/baseline_account_circle_24" />

            <TextView
                android:id="@+id/textSwapPostUser"
                android:layout_width="155dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:gravity="center|left"
                android:text="유저 이름"
                android:textColor="#000000"
                android:textSize="13dp"
                app:layout_constraintBottom_toBottomOf="@+id/imgSwapPostUser"
                app:layout_constraintStart_toEndOf="@+id/imgSwapPostUser"
                app:layout_constraintTop_toTopOf="@+id/imgSwapPostUser" />

            <Button
                android:id="@+id/btnSwapPostUser"
                android:layout_width="205dp"
                android:layout_height="30dp"
                android:layout_marginBottom="1dp"
                android:backgroundTint="#27713C"
                android:fontFamily="@font/soyo_maple_regular"
                android:gravity="center"
                android:padding="1dp"
                android:text="님의 라이브러리"
                android:textColor="#FFFFFF"
                android:textSize="10dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/borderSwapPost"
                app:layout_constraintEnd_toEndOf="@+id/borderSwapPost"
                app:layout_constraintStart_toStartOf="@+id/borderSwapPost" />

            <FrameLayout
                android:id="@+id/frameLayout2"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/border_s_post_brown"
                android:clickable="true"
                android:elevation="3dp"
                app:layout_constraintEnd_toStartOf="@+id/frameLayout3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameSwapPost">

                <ImageView
                    android:id="@+id/imgSwapPostBook1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="1.2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_image_24" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayout3"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/border_s_post_brown"
                android:clickable="true"
                android:elevation="3dp"
                app:layout_constraintEnd_toStartOf="@+id/frameLayout4"
                app:layout_constraintStart_toEndOf="@+id/frameLayout2"
                app:layout_constraintTop_toTopOf="@+id/frameLayout2">

                <ImageView
                    android:id="@+id/imgSwapPostBook2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="1.2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_image_24" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayout4"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/border_s_post_brown"
                android:clickable="true"
                android:elevation="3dp"
                app:layout_constraintEnd_toStartOf="@+id/frameLayout5"
                app:layout_constraintStart_toEndOf="@+id/frameLayout3"
                app:layout_constraintTop_toTopOf="@+id/frameLayout3">

                <ImageView
                    android:id="@+id/imgSwapPostBook3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="1.2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_image_24" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayout5"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/border_s_post_brown"
                android:clickable="true"
                android:elevation="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/frameLayout4"
                app:layout_constraintTop_toTopOf="@+id/frameLayout4">

                <ImageView
                    android:id="@+id/imgSwapPostBook4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="1.2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_image_24" />

            </FrameLayout>

            <View
                android:id="@+id/dividerSwapPost3"
                android:layout_width="wrap_content"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#CCCCCC"
                android:elevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayout2" />

            <TextView
                android:id="@+id/textSwapPost2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:text="도서 정가"
                android:textColor="#000000"
                android:textSize="13dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textSwapPost3" />

            <TextView
                android:id="@+id/textSwapPostRegPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:text="0원"
                android:textColor="#000000"
                android:textSize="16dp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="@+id/textSwapPost2"
                app:layout_constraintStart_toEndOf="@+id/textSwapPost2"
                app:layout_constraintTop_toTopOf="@+id/textSwapPost2" />

            <TextView
                android:id="@+id/textSwapPost3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:text="도서 상태"
                android:textColor="#000000"
                android:textSize="13dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dividerSwapPost3" />

            <ImageView
                android:id="@+id/imgSwapPostEmotion"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/baseline_sentiment_neutral_10"
                app:layout_constraintBottom_toBottomOf="@+id/textSwapPost3"
                app:layout_constraintStart_toEndOf="@+id/textSwapPost3"
                app:layout_constraintTop_toTopOf="@+id/textSwapPost3" />

            <TextView
                android:id="@+id/textSwapPostState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:text="상태"
                android:textColor="#000000"
                android:textSize="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/imgSwapPostEmotion"
                app:layout_constraintStart_toEndOf="@+id/imgSwapPostEmotion"
                app:layout_constraintTop_toTopOf="@+id/imgSwapPostEmotion" />

            <TextView
                android:id="@+id/textSwapPost4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/soyo_maple_regular"
                android:text="도서 설명"
                android:textColor="#000000"
                android:textSize="13dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textSwapPost2" />

            <TextView
                android:id="@+id/textSwapPostExplain"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/border_post_main"
                android:fontFamily="@font/soyo_maple_regular"
                android:padding="10dp"
                android:text="도서 설명 내용"
                android:textColor="#000000"
                android:textSize="14dp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textSwapPost4" />

            <Button
                android:id="@+id/btnSwapPostChatRequest"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="#27713C"
                android:elevation="3dp"
                android:fontFamily="@font/soyo_maple_bold"
                android:padding="1dp"
                android:text="채팅 요청"
                android:textColor="#F9FBF4"
                android:textSize="20dp"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textSwapPostExplain" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerSwapPostImages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/border_dark_brown_viewpager"
        android:padding="3dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutSwapPost" />

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|top"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:src="@drawable/baseline_close_24"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/viewPagerSwapPostImages"
        app:layout_constraintTop_toTopOf="@+id/viewPagerSwapPostImages" />

</androidx.constraintlayout.widget.ConstraintLayout>