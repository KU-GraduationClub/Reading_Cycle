<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".login.LoginMainFragment"
    android:transitionGroup="true">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="156dp"
        android:layout_height="148dp"
        android:layout_marginStart="127dp"
        android:layout_marginTop="130dp"
        android:layout_marginEnd="128dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/logo_reading_cycle"
        app:layout_constraintBottom_toTopOf="@+id/textTitleMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textTitleMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="83dp"
        android:layout_marginTop="268dp"
        android:layout_marginEnd="80dp"
        android:fontFamily="@font/soyo_maple_bold"
        android:gravity="center"
        android:text="우리동네 책장터, 리딩사이클"
        android:textColor="#1B1818"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/textSubtitleMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textSubtitleMain"
        android:layout_width="362dp"
        android:layout_height="65dp"
        android:layout_marginStart="168dp"
        android:layout_marginEnd="165dp"
        android:fontFamily="@font/soyo_maple_regular"
        android:gravity="center"
        android:lineSpacingExtra="10dp"
        android:text="편리한 중고 도서 거래로 \n친환경적인 독서활동의 첫걸음을 시작해보세요!"
        android:textAlignment="center"
        android:textColor="#1B1818"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.508"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitleMain" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="325dp"
        android:layout_height="54dp"
        android:layout_marginStart="43dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="43dp"
        android:background="@drawable/shape_stroke"
        android:backgroundTint="@color/theme_green"
        android:elevation="0dp"
        android:fontFamily="@font/soyo_maple_regular"
        android:gravity="center"
        android:text="시작하기"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textSubtitleMain"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>