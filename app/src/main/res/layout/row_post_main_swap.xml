<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="61dp"
        android:layout_height="89dp"
        android:layout_marginStart="13dp"
        android:layout_marginTop="9dp"
        android:background="#9A9393"
        android:elevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgRowPostSwapPoster"
            android:layout_width="60dp"
            android:layout_height="88dp"
            android:background="@color/white"
            app:srcCompat="@drawable/baseline_image_24" />

    </FrameLayout>

    <TextView
        android:id="@+id/textRowPostSwapTitle"
        android:layout_width="163dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:fontFamily="@font/soyo_maple_regular"
        android:maxLines="1"
        android:text="책 제목"
        android:textColor="#000000"
        android:textSize="15dp"
        app:layout_constraintStart_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textRowPostSwap1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="9dp"
        android:fontFamily="@font/soyo_maple_bold"
        android:text="작가  "
        android:textColor="#27713C"
        android:textSize="10dp"
        app:layout_constraintStart_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toBottomOf="@+id/textRowPostSwapTitle" />

    <TextView
        android:id="@+id/textRowPostSwapAuthor"
        android:layout_width="137dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/soyo_maple_regular"
        android:maxLines="1"
        android:text="작가 이름"
        android:textColor="#000000"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/textRowPostSwap1"
        app:layout_constraintStart_toEndOf="@+id/textRowPostSwap1"
        app:layout_constraintTop_toTopOf="@+id/textRowPostSwap1" />

    <Button
        android:id="@+id/btnRowPostSwapType"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="13dp"
        android:layout_weight="1"
        android:background="@drawable/border_add_post_orange"
        android:clickable="false"
        android:fontFamily="@font/soyo_maple_bold"
        android:padding="3dp"
        android:text="도서 종류"
        android:textColor="#633807"
        android:textSize="11dp"
        app:layout_constraintStart_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toBottomOf="@+id/textRowPostSwap1" />

    <Button
        android:id="@+id/btnRowPostSwapType2"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:background="@drawable/border_add_post_blue"
        android:clickable="false"
        android:ellipsize="end"
        android:fontFamily="@font/soyo_maple_bold"
        android:maxLines="1"
        android:padding="5dp"
        android:text="교환 종류"
        android:textColor="#232F9F"
        android:textSize="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRowPostSwapType"
        app:layout_constraintStart_toEndOf="@+id/imgRowPostSwapType"
        app:layout_constraintTop_toTopOf="@+id/btnRowPostSwapType" />

    <ImageView
        android:id="@+id/imgRowPostSwapType"
        android:layout_width="25dp"
        android:layout_height="24dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRowPostSwapType"
        app:layout_constraintStart_toEndOf="@+id/btnRowPostSwapType"
        app:layout_constraintTop_toTopOf="@+id/btnRowPostSwapType"
        app:srcCompat="@drawable/baseline_sync_40_blue" />

    <View
        android:id="@+id/BorderRowPostSwap1"
        android:layout_width="130dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/border_post_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textRowPostSwap2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/soyo_maple_regular"
        android:text="도서 정가"
        android:textColor="#000000"
        android:textSize="8dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/BorderRowPostSwap1"
        app:layout_constraintTop_toTopOf="@+id/BorderRowPostSwap1" />

    <TextView
        android:id="@+id/textRowPostSwapRegPrice"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/soyo_maple_regular"
        android:gravity="right"
        android:maxLines="1"
        android:text="0"
        android:textColor="#000000"
        android:textSize="8dp"
        app:layout_constraintEnd_toEndOf="@+id/BorderRowPostSwap1"
        app:layout_constraintTop_toTopOf="@+id/BorderRowPostSwap1" />

    <TextView
        android:id="@+id/textRowPostSwap3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/soyo_maple_regular"
        android:text="도서 상태"
        android:textColor="#000000"
        android:textSize="8dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/BorderRowPostSwap1"
        app:layout_constraintStart_toStartOf="@+id/BorderRowPostSwap1" />

    <ImageView
        android:id="@+id/imgRowPostSwapState"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/BorderRowPostSwap1"
        app:layout_constraintEnd_toStartOf="@+id/textRowPostSwapState"
        app:srcCompat="@drawable/baseline_sentiment_neutral_24" />

    <TextView
        android:id="@+id/textRowPostSwapState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/soyo_maple_regular"
        android:text="상태"
        android:textColor="#000000"
        android:textSize="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/BorderRowPostSwap1"
        app:layout_constraintEnd_toEndOf="@+id/BorderRowPostSwap1" />

    <FrameLayout
        android:id="@+id/FrameRowPostSwap"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/BorderRowPostSwap1">

        <View
            android:id="@+id/BorderRowPostSwap2"
            android:layout_width="95dp"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/border_post_main"
            android:clickable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/BorderRowPostSwap1" />

        <ImageView
            android:id="@+id/imgRowPostSwapUser"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="@+id/BorderRowPostSwap2"
            app:layout_constraintTop_toTopOf="@+id/BorderRowPostSwap2"
            app:srcCompat="@drawable/baseline_account_circle_24" />

        <TextView
            android:id="@+id/textRowPostSwapUser"
            android:layout_width="60dp"
            android:layout_height="18dp"
            android:layout_marginLeft="26dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/soyo_maple_regular"
            android:gravity="center|left"
            android:maxLines="1"
            android:text="유저 이름"
            android:textColor="#000000"
            android:textSize="8dp"
            app:layout_constraintStart_toEndOf="@+id/imgRowPostSwapUser"
            app:layout_constraintTop_toTopOf="@+id/BorderRowPostSwap2" />

    </FrameLayout>

    <View
        android:id="@+id/dividerRowPostMain"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="10dp"
        android:background="#9A9393"
        android:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>