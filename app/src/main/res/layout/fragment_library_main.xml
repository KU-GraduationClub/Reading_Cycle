<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutLibraryMain"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLayoutLibraryMain"
            style="@style/Theme.Reading_cycle.ToolbarTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/Theme.Reading_cycle.ToolbarTheme"
            app:menu="@menu/toolbar_library"
            app:navigationIcon="@drawable/baseline_arrow_back_ios_28">

            <TextView
                android:id="@+id/toolbarLibraryMainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/soyo_maple_bold"
                android:gravity="center"
                android:paddingTop="2dp"
                android:text="라이브러리"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#27713C"
                android:textSize="16dp"/>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/dividerLibraryMain1"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#B2C8AA"
        android:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutLibraryMain" />

    <View
        android:id="@+id/dividerLibraryMain2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#B2C8AA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileContainer" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayoutLibraryMain">

        <ImageView
            android:id="@+id/imgLibraryMainProfile"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/baseline_account_circle_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textLibraryMainUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/soyo_maple_regular"
            android:text="사용자"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/imgLibraryMainProfile"
            app:layout_constraintTop_toTopOf="@+id/imgLibraryMainProfile" />

        <TextView
            android:id="@+id/textLibraryMain1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/soyo_maple_regular"
            android:text="님의 라이브러리"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/textLibraryMainUser"
            app:layout_constraintTop_toBottomOf="@+id/textLibraryMainUser" />

        <!-- 게시글 수 및 친구 수 텍스트 -->
        <TextView
            android:id="@+id/textLibraryMainPostLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/soyo_maple_regular"
            android:text="게시물"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/textLibraryMain1"
            app:layout_constraintTop_toBottomOf="@+id/textLibraryMain1" />

        <TextView
            android:id="@+id/textLibraryMainPostCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/soyo_maple_regular"
            android:text="0"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/textLibraryMainPostLabel"
            app:layout_constraintStart_toEndOf="@+id/textLibraryMainPostLabel" />

        <Button
            android:id="@+id/btnLibAdd"
            android:layout_width="80dp"
            android:layout_height="27dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/border_add_post_green"
            android:fontFamily="@font/soyo_maple_regular"
            android:text="친구 추가"
            android:textColor="@color/theme_green"
            android:textSize="10dp"
            android:visibility="gone"
            android:enabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textLibraryMainUser" />

        <TextView
            android:id="@+id/textLibraryUserLoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/soyo_maple_regular"
            android:text="지역 표시"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/imgLibraryMainProfile"
            app:layout_constraintTop_toBottomOf="@+id/imgLibraryMainProfile" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLibraryMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/dividerLibraryMain2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:padding="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>