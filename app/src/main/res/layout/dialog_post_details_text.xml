<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:divider="?android:attr/dividerHorizontal"
    android:dividerPadding="8dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/labelPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/soyo_maple_bold"
        android:gravity="center|left"
        android:paddingBottom="4dp"
        android:text="도서 제목"
        android:textColor="@color/theme_green"
        android:textSize="15dp" />

    <TextView
        android:id="@+id/dialogPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/border_dark_brown_dialog"
        android:fontFamily="@font/soyo_maple_regular"
        android:padding="8dp"
        android:textColor="@android:color/black"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/labelPostAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/soyo_maple_bold"
        android:gravity="center|left"
        android:paddingBottom="4dp"
        android:text="작가"
        android:textColor="@color/theme_green"
        android:textSize="15dp" />

    <TextView
        android:id="@+id/dialogPostAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/border_dark_brown_dialog"
        android:fontFamily="@font/soyo_maple_regular"
        android:padding="8dp"
        android:textColor="@android:color/black"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/labelPostDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/soyo_maple_bold"
        android:gravity="center|left"
        android:paddingBottom="4dp"
        android:text="도서 설명"
        android:textColor="@color/theme_green"
        android:textSize="15dp" />

    <TextView
        android:id="@+id/dialogPostDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/border_dark_brown_dialog"
        android:fontFamily="@font/soyo_maple_regular"
        android:padding="8dp"
        android:textColor="@android:color/black"
        android:textSize="20dp" />

</LinearLayout>